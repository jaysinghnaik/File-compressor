{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/assets/$1"
    },
    {
      "src": "/icon.svg",
      "headers": { "cache-control": "public, max-age=86400" },
      "dest": "/icon.svg"
    },
    {
      "src": "/manifest.json",
      "headers": { "cache-control": "public, max-age=3600" },
      "dest": "/manifest.json"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
